PORT=3000
HOST=127.0.0.1

# Mock 模式（推荐面试/demo）：不依赖 cursor-agent CLI，RAG + POI 检索仍走真实逻辑
MOCK_AGENT=true

# RAG 向量检索：tfidf（默认，本地）| openai（需 OPENAI_API_KEY + npm run rag:embed -w backend）
RAG_EMBEDDING_PROVIDER=tfidf
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CURSOR_AGENT_COMMAND=cursor-agent
CURSOR_TIMEOUT_MS=300000
# Fail fast if cursor-agent produces no output (invalid API key often causes silent hangs)
CURSOR_STALL_MS=45000
# Auth: default uses `cursor-agent login` session. To use API key instead, set:
# CURSOR_USE_API_KEY=true
# CURSOR_API_KEY=your_valid_key_here

# SQLite database path (optional, default: data/travel.db)
# TRAVEL_DB_PATH=./data/travel.db
