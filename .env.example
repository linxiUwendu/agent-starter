PORT=3000
HOST=127.0.0.1

# Google 登录（GIS 一键登录，仅需 Web Client ID，无需 Client Secret）
# 在 Google Cloud Console 创建「Web 应用」OAuth 客户端，授权 JavaScript 来源填 http://127.0.0.1:5173
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# 国内 backend 常无法直连 googleapis.com：可为 Node 配置代理，或开发环境依赖默认的 GIS 本地解析降级
# HTTPS_PROXY=http://127.0.0.1:7890
# AUTH_GOOGLE_INSECURE_LOCAL_JWT=false  # 生产必须为 false 或勿设置；开发默认 true（网络失败时不验签解析 JWT）
# 可选：前端与后端同 ID（后端 /api/auth/config 也会下发）
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# JWT_SECRET=change-me-in-production
# 本地无 Google 时可开启演示邮箱登录（勿用于生产）
# AUTH_ALLOW_DEV_LOGIN=true

# Mock 模式（推荐面试/demo）：Tool Loop 走规则 Mock + cursor-agent Mock 回答；RAG/POI 仍走真实逻辑
# MOCK_AGENT=true
# Tool Loop 选工具：rules=本地意图规则（默认，快）| agent=每轮 cursor-agent（慢，不推荐）
# TRAVEL_TOOL_PLANNER=rules
# agent 模式下最多几轮工具后再问 Planner；默认 1（避免 4× runCollect + 1× 写答案 ≈ 2.6min）
# TRAVEL_AGENT_PLANNER_MAX_ROUNDS=1
# 检索前置：进入 Tool Loop 前自动 hybrid RAG（默认开启；设为 false 关闭）
# TRAVEL_RAG_PREFETCH=true
# 最终回答：cursor=CLI 生成（默认）| fallback=仅 POI/RAG 摘要（cursor 常 ETIMEDOUT 时可先用）
# TRAVEL_ANSWER=cursor

# RAG 向量检索：tfidf（默认，本地）| openai（需 OPENAI_API_KEY + npm run rag:embed -w backend）
RAG_EMBEDDING_PROVIDER=tfidf
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CURSOR_AGENT_COMMAND=cursor-agent
CURSOR_TIMEOUT_MS=300000
# Fail fast if cursor-agent produces no output (invalid API key often causes silent hangs)
CURSOR_STALL_MS=45000
# ETIMEDOUT / [unavailable] 等网络错误时的额外重试次数（默认 1，即最多调用 2 次）
# CURSOR_AGENT_RETRIES=1
# 子进程启动方式：默认 direct（推荐）。勿设 login，zsh -il 易导致 cursor-agent ETIMEDOUT
# CURSOR_AGENT_SPAWN_SHELL=direct
# Auth: default uses `cursor-agent login` session. To use API key instead, set:
# CURSOR_USE_API_KEY=true
# CURSOR_API_KEY=your_valid_key_here

# SQLite database path (optional, default: data/travel.db)
# TRAVEL_DB_PATH=./data/travel.db

# 知识库运维（可选）：配置 TRAVEL_KB_ADMIN_KEY 后前端会出现「运维登录」，密钥仅在后端校验
# TRAVEL_KB_ADMIN_KEY=change-me-in-production
# VITE_KB_ADMIN_KEY=  # 可选，与上相同时可省略 /rag/admin-login 请求（不推荐生产环境写入前端）
